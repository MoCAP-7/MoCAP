diff --git a/trajectory_manager/include/trajectory_manager/platform_time_scale.hpp b/trajectory_manager/include/trajectory_manager/platform_time_scale.hpp
new file mode 100644
index 0000000..f6f687f
--- /dev/null
+++ b/trajectory_manager/include/trajectory_manager/platform_time_scale.hpp
@@ -0,0 +1,452 @@
+#ifndef _PLATFORM_TIME_SCALE_HPP_
+#define _PLATFORM_TIME_SCALE_HPP_
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+#include "gcopter/trajectory.hpp"
+
+namespace apexnav_planner {
+// Uniform time scaling of an optimized trajectory to platform limits. q(t) = p(t / k)
+// traces the same path: speed and heading rate scale by 1 / k, acceleration and heading
+// acceleration by 1 / k^2.
+
+// A non-positive limit disables its term.
+struct PlatformLimits {
+  double max_vel = 0.0;
+  double max_acc = 0.0;
+  double max_omega = 0.0;
+  double max_domega = 0.0;
+};
+
+struct PlatformPeaks {
+  double vel = 0.0;
+  double acc = 0.0;
+  double omega = 0.0;
+  double domega = 0.0;
+};
+
+struct PlatformTimeScale {
+  double k = 1.0;
+  const char* binding = "none";
+  PlatformPeaks before;
+  PlatformPeaks after;
+};
+
+// Planar peaks sampled every sample_dt. Heading is undefined at rest, so heading rate and
+// heading acceleration use the optimizer's heading penalty expressions only where the planar
+// speed exceeds min_speed.
+inline PlatformPeaks measurePlatformPeaks(
+    const Trajectory<7, 3>& traj, double sample_dt, double min_speed)
+{
+  PlatformPeaks peaks;
+  Eigen::Matrix2d B_h;
+  B_h << 0.0, -1.0, 1.0, 0.0;
+  for (int i = 0; i < traj.getPieceNum(); ++i) {
+    const double duration = traj[i].getDuration();
+    int steps = 1;
+    if (sample_dt > 0.0 && duration > sample_dt) {
+      steps = static_cast<int>(std::ceil(duration / sample_dt));
+    }
+    for (int s = 0; s <= steps; ++s) {
+      const double t = duration * s / steps;
+      const Eigen::Vector2d v = traj[i].getVel(t).head(2);
+      const Eigen::Vector2d a = traj[i].getAcc(t).head(2);
+      const double speed = v.norm();
+      peaks.vel = std::max(peaks.vel, speed);
+      peaks.acc = std::max(peaks.acc, a.norm());
+      if (speed <= min_speed) continue;
+      const Eigen::Vector2d j = traj[i].getJer(t).head(2);
+      const double inv_v2 = 1.0 / (speed * speed);
+      const double cross_va = a.dot(B_h * v);
+      peaks.omega = std::max(peaks.omega, std::abs(cross_va * inv_v2));
+      peaks.domega = std::max(peaks.domega,
+          std::abs(j.dot(B_h * v) * inv_v2 - 2.0 * cross_va * a.dot(v) * inv_v2 * inv_v2));
+    }
+  }
+  return peaks;
+}
+
+// Smallest k >= 1 that brings every peak within its limit; binding names the term that sets k.
+inline double platformTimeScale(
+    const PlatformPeaks& peaks, const PlatformLimits& limits, const char** binding)
+{
+  double k = 1.0;
+  const char* name = "none";
+  auto consider = [&](double candidate, const char* term) {
+    if (candidate > k) {
+      k = candidate;
+      name = term;
+    }
+  };
+  if (limits.max_vel > 0.0) consider(peaks.vel / limits.max_vel, "vel");
+  if (limits.max_omega > 0.0) consider(peaks.omega / limits.max_omega, "yaw_rate");
+  if (limits.max_acc > 0.0) consider(std::sqrt(peaks.acc / limits.max_acc), "acc");
+  if (limits.max_domega > 0.0) consider(std::sqrt(peaks.domega / limits.max_domega), "yaw_acc");
+  if (binding != nullptr) *binding = name;
+  return k;
+}
+
+inline Trajectory<7, 3> scaleTrajectoryTime(const Trajectory<7, 3>& traj, double k)
+{
+  std::vector<double> durations;
+  std::vector<Piece<7, 3>::CoefficientMat> coefficients;
+  durations.reserve(traj.getPieceNum());
+  coefficients.reserve(traj.getPieceNum());
+  for (int i = 0; i < traj.getPieceNum(); ++i) {
+    // Column j multiplies t^(7 - j).
+    Piece<7, 3>::CoefficientMat coefficient = traj[i].getCoeffMat();
+    for (int j = 0; j < 8; ++j) coefficient.col(j) /= std::pow(k, 7 - j);
+    durations.push_back(traj[i].getDuration() * k);
+    coefficients.push_back(coefficient);
+  }
+  return Trajectory<7, 3>(durations, coefficients);
+}
+
+// Scales traj until its sampled peaks fit limits. The scaled trajectory is re-measured four
+// times more densely, so a narrow heading-rate spike that fell between the first samples still
+// enlarges k.
+inline Trajectory<7, 3> scaleToPlatformLimits(const Trajectory<7, 3>& traj,
+    const PlatformLimits& limits, double sample_dt, double min_speed, int max_refinements,
+    PlatformTimeScale* report)
+{
+  PlatformTimeScale result;
+  result.before = measurePlatformPeaks(traj, sample_dt, min_speed);
+  result.k = platformTimeScale(result.before, limits, &result.binding);
+  Trajectory<7, 3> scaled = result.k > 1.0 ? scaleTrajectoryTime(traj, result.k) : traj;
+  result.after = measurePlatformPeaks(scaled, sample_dt * result.k / 4.0, min_speed / result.k);
+  for (int refinement = 0; refinement < max_refinements; ++refinement) {
+    const char* residual_binding = "none";
+    const double residual = platformTimeScale(result.after, limits, &residual_binding);
+    if (!(residual > 1.0 + 1e-9)) break;
+    result.k *= residual;
+    result.binding = residual_binding;
+    scaled = scaleTrajectoryTime(traj, result.k);
+    result.after = measurePlatformPeaks(scaled, sample_dt * result.k / 4.0, min_speed / result.k);
+  }
+  if (report != nullptr) *report = result;
+  return scaled;
+}
+
+// Retiming q(t) = p(tau(t)) also traces the same path, but the rate r = dtau/dt varies along it:
+// speed and heading rate scale by r, and acceleration and heading acceleration take a term in
+// r^2 plus one in dr/dt. The trajectory reaches the limits as soon as the acceleration limits
+// allow, instead of stretching the optimizer's own ramps by a single factor.
+
+struct PlatformRetimeOptions {
+  // Spacing of the samples along the input, in input time.
+  double sample_dt = 0.002;
+  // Heading terms divide by the squared input speed, but by at least this speed squared.
+  double min_speed = 0.05;
+  // The result is built from pieces of constant rate. A piece is at most this much slower in
+  // speed and in heading rate than the retimed profile at its samples, which also bounds the
+  // velocity steps between pieces.
+  double speed_step = 0.002;
+  double yaw_rate_step = 0.005;
+  double max_piece_duration = 1.0;
+};
+
+struct PlatformRetime {
+  PlatformPeaks before;
+  // Speed and heading rate as sampled; acceleration and heading acceleration as differences
+  // over a window of several pieces, so the steps between pieces average out.
+  PlatformPeaks after;
+  double duration_before = 0.0;
+  double duration_after = 0.0;
+  double start_speed_before = 0.0;
+  double start_speed_after = 0.0;
+  int pieces_before = 0;
+  int pieces_after = 0;
+};
+
+namespace platform_retime_detail {
+constexpr double kRest = 1e-9;
+constexpr double kMinRate = 1e-3;
+
+inline double cross2(const Eigen::Vector2d& a, const Eigen::Vector2d& b)
+{
+  return a.x() * b.y() - a.y() * b.x();
+}
+
+// Input quantities at one sample, per unit input time.
+struct Sample {
+  int piece = 0;
+  double sigma = 0.0;       // time within the piece
+  double tau = 0.0;         // time from the trajectory start
+  double speed = 0.0;       // |v|
+  double tangential = 0.0;  // a . v / |v|
+  double normal = 0.0;      // |v x a| / |v|, or |a| at rest
+  double yaw_rate = 0.0;    // (v x a) / max(|v|, min_speed)^2
+  double yaw_acc = 0.0;     // its derivative
+  double cap = 1.0;         // largest x = r^2 whose limits hold for some dx/dtau
+};
+
+// Range of s = dx/dtau at x that keeps acceleration and heading acceleration within limits:
+// a_tangential = tangential x + speed s / 2, a_normal = normal x and
+// heading acceleration = yaw_acc x + yaw_rate s / 2. False if no s does.
+inline bool slopeRange(
+    const Sample& sample, double x, const PlatformLimits& limits, double* low, double* high)
+{
+  *low = -std::numeric_limits<double>::infinity();
+  *high = std::numeric_limits<double>::infinity();
+  if (limits.max_acc > 0.0) {
+    const double normal = sample.normal * x;
+    if (normal > limits.max_acc) return false;
+    const double reserve = std::sqrt(limits.max_acc * limits.max_acc - normal * normal);
+    const double tangential = sample.tangential * x;
+    if (sample.speed > kRest) {
+      *low = std::max(*low, 2.0 * (-reserve - tangential) / sample.speed);
+      *high = std::min(*high, 2.0 * (reserve - tangential) / sample.speed);
+    }
+    else if (std::abs(tangential) > reserve) {
+      return false;
+    }
+  }
+  if (limits.max_domega > 0.0) {
+    const double drift = sample.yaw_acc * x;
+    if (std::abs(sample.yaw_rate) > kRest) {
+      double a = 2.0 * (-limits.max_domega - drift) / sample.yaw_rate;
+      double b = 2.0 * (limits.max_domega - drift) / sample.yaw_rate;
+      if (a > b) std::swap(a, b);
+      *low = std::max(*low, a);
+      *high = std::min(*high, b);
+    }
+    else if (std::abs(drift) > limits.max_domega) {
+      return false;
+    }
+  }
+  return *low <= *high;
+}
+
+// Largest x in [0, upper] with accept(x), for an accept that holds on an interval containing 0.
+template <typename Accept>
+inline double largestAccepted(double upper, const Accept& accept)
+{
+  if (accept(upper)) return upper;
+  double accepted = 0.0, rejected = upper;
+  for (int iteration = 0; iteration < 60; ++iteration) {
+    const double middle = 0.5 * (accepted + rejected);
+    if (accept(middle))
+      accepted = middle;
+    else
+      rejected = middle;
+  }
+  return accepted;
+}
+
+inline Sample makeSample(const Piece<7, 3>& piece, int index, double sigma, double tau,
+    const PlatformLimits& limits, double min_speed)
+{
+  Sample sample;
+  sample.piece = index;
+  sample.sigma = sigma;
+  sample.tau = tau;
+  const Eigen::Vector2d v = piece.getVel(sigma).head(2);
+  const Eigen::Vector2d a = piece.getAcc(sigma).head(2);
+  const Eigen::Vector2d j = piece.getJer(sigma).head(2);
+  const double cross_va = cross2(v, a);
+  sample.speed = v.norm();
+  if (sample.speed > kRest) {
+    sample.tangential = a.dot(v) / sample.speed;
+    sample.normal = std::abs(cross_va) / sample.speed;
+  }
+  else {
+    sample.normal = a.norm();
+  }
+  const double v2 = sample.speed * sample.speed;
+  const double floor2 = std::max(min_speed * min_speed, kRest);
+  if (v2 > floor2) {
+    sample.yaw_rate = cross_va / v2;
+    sample.yaw_acc = cross2(v, j) / v2 - 2.0 * cross_va * a.dot(v) / (v2 * v2);
+  }
+  else {
+    sample.yaw_rate = cross_va / floor2;
+    sample.yaw_acc = cross2(v, j) / floor2;
+  }
+
+  double cap = 1.0;
+  if (limits.max_vel > 0.0 && sample.speed > kRest)
+    cap = std::min(cap, std::pow(limits.max_vel / sample.speed, 2));
+  if (limits.max_omega > 0.0 && std::abs(sample.yaw_rate) > kRest)
+    cap = std::min(cap, std::pow(limits.max_omega / std::abs(sample.yaw_rate), 2));
+  sample.cap = largestAccepted(cap, [&](double x) {
+    double low, high;
+    return slopeRange(sample, x, limits, &low, &high);
+  });
+  return sample;
+}
+
+// Coefficients of p(sigma + rate t) for a piece p. Column j multiplies t^(7 - j).
+inline Piece<7, 3>::CoefficientMat subPieceCoefficients(
+    const Piece<7, 3>::CoefficientMat& coefficients, double sigma, double rate)
+{
+  Piece<7, 3>::CoefficientMat result = Piece<7, 3>::CoefficientMat::Zero();
+  for (int m = 0; m <= 7; ++m) {
+    // (sigma + rate t)^m = sum over n of C(m, n) sigma^(m - n) rate^n t^n
+    double choose = 1.0;
+    for (int n = 0; n <= m; ++n) {
+      result.col(7 - n) +=
+          coefficients.col(7 - m) * (choose * std::pow(sigma, m - n) * std::pow(rate, n));
+      choose = choose * (m - n) / (n + 1);
+    }
+  }
+  return result;
+}
+
+inline PlatformPeaks measureRetimedPeaks(
+    const Trajectory<7, 3>& traj, const std::vector<double>& rates, double min_speed)
+{
+  const double sample_dt = 0.01;
+  const double window = 0.2;
+  PlatformPeaks peaks;
+  std::vector<double> times, speeds, turns;
+  double start = 0.0;
+  for (int i = 0; i < traj.getPieceNum(); ++i) {
+    const double duration = traj[i].getDuration();
+    const int steps = std::max(1, static_cast<int>(std::ceil(duration / sample_dt)));
+    const double floor2 = std::max(std::pow(min_speed * rates[i], 2), kRest);
+    for (int s = 0; s <= steps; ++s) {
+      const double t = duration * s / steps;
+      const Eigen::Vector2d v = traj[i].getVel(t).head(2);
+      const Eigen::Vector2d a = traj[i].getAcc(t).head(2);
+      const double speed = v.norm();
+      const double turn = cross2(v, a) / std::max(speed * speed, floor2);
+      times.push_back(start + t);
+      speeds.push_back(speed);
+      turns.push_back(turn);
+      peaks.vel = std::max(peaks.vel, speed);
+      peaks.omega = std::max(peaks.omega, std::abs(turn));
+    }
+    start += duration;
+  }
+  size_t later = 0;
+  for (size_t i = 0; i < times.size(); ++i) {
+    while (later < times.size() && times[later] < times[i] + window) ++later;
+    if (later == times.size()) break;
+    const double dt = times[later] - times[i];
+    const double tangential = (speeds[later] - speeds[i]) / dt;
+    peaks.acc = std::max(peaks.acc, std::hypot(tangential, std::abs(turns[i]) * speeds[i]));
+    peaks.domega = std::max(peaks.domega, std::abs(turns[later] - turns[i]) / dt);
+  }
+  return peaks;
+}
+}  // namespace platform_retime_detail
+
+// Retimes traj along its own path to the limits. On samples of the input, a backward pass lowers
+// x = r^2 wherever the trajectory could not otherwise slow down in time, and a forward pass from
+// the start raises it as fast as the acceleration limits allow; x is linear in tau between
+// samples. r never exceeds 1, so the result is never faster than the input, and the start
+// velocity is kept unless it exceeds a limit. The result is cut from the input pieces into
+// pieces of constant rate, so its positions are the input's.
+inline Trajectory<7, 3> retimeToPlatformLimits(const Trajectory<7, 3>& traj,
+    const PlatformLimits& limits, const PlatformRetimeOptions& options, PlatformRetime* report)
+{
+  using namespace platform_retime_detail;
+  PlatformRetime result;
+  const int piece_num = traj.getPieceNum();
+  result.pieces_before = piece_num;
+  result.duration_before = traj.getTotalDuration();
+  result.before = measurePlatformPeaks(traj, options.sample_dt, options.min_speed);
+  if (piece_num == 0) {
+    if (report != nullptr) *report = result;
+    return traj;
+  }
+  result.start_speed_before = traj.getVel(0.0).head(2).norm();
+
+  std::vector<Sample> samples;
+  std::vector<int> first_sample(piece_num + 1);
+  double piece_start = 0.0;
+  for (int i = 0; i < piece_num; ++i) {
+    const double duration = traj[i].getDuration();
+    int steps = 1;
+    if (options.sample_dt > 0.0 && duration > options.sample_dt)
+      steps = static_cast<int>(std::ceil(duration / options.sample_dt));
+    first_sample[i] = static_cast<int>(samples.size());
+    for (int s = 0; s < steps; ++s) {
+      const double sigma = duration * s / steps;
+      samples.push_back(
+          makeSample(traj[i], i, sigma, piece_start + sigma, limits, options.min_speed));
+    }
+    piece_start += duration;
+  }
+  samples.push_back(makeSample(traj[piece_num - 1], piece_num - 1,
+      traj[piece_num - 1].getDuration(), piece_start, limits, options.min_speed));
+  first_sample[piece_num] = static_cast<int>(samples.size()) - 1;
+  const int last = first_sample[piece_num];
+
+  std::vector<double> bound(samples.size());
+  bound[last] = samples[last].cap;
+  for (int k = last - 1; k >= 0; --k) {
+    const double step = samples[k + 1].tau - samples[k].tau;
+    bound[k] = largestAccepted(samples[k].cap, [&](double x) {
+      double low, high;
+      if (!slopeRange(samples[k], x, limits, &low, &high)) return false;
+      return step <= 0.0 ? x <= bound[k + 1] : x + step * low <= bound[k + 1];
+    });
+  }
+  std::vector<double> rate(samples.size());
+  double x = bound[0];
+  rate[0] = std::max(std::sqrt(x), kMinRate);
+  for (int k = 0; k < last; ++k) {
+    const double step = samples[k + 1].tau - samples[k].tau;
+    double low, high;
+    slopeRange(samples[k], x, limits, &low, &high);
+    double next = bound[k + 1];
+    if (step > 0.0 && std::isfinite(high)) next = std::min(next, x + step * high);
+    x = std::max(next, 0.0);
+    rate[k + 1] = std::max(std::sqrt(x), kMinRate);
+  }
+
+  std::vector<double> durations, rates;
+  std::vector<Piece<7, 3>::CoefficientMat> coefficients;
+  for (int i = 0; i < piece_num; ++i) {
+    const int end = first_sample[i + 1];
+    int begin = first_sample[i];
+    while (begin < end) {
+      double low = std::min(rate[begin], rate[begin + 1]);
+      double high = std::max(rate[begin], rate[begin + 1]);
+      double speed = std::max(samples[begin].speed, samples[begin + 1].speed);
+      double turn = std::max(std::abs(samples[begin].yaw_rate), std::abs(samples[begin + 1].yaw_rate));
+      int stop = begin + 1;
+      while (stop < end) {
+        const double next_low = std::min(low, rate[stop + 1]);
+        const double next_high = std::max(high, rate[stop + 1]);
+        const double next_speed = std::max(speed, samples[stop + 1].speed);
+        const double next_turn = std::max(turn, std::abs(samples[stop + 1].yaw_rate));
+        const double spread = next_high - next_low;
+        if (next_speed * spread > options.speed_step || next_turn * spread > options.yaw_rate_step ||
+            (samples[stop + 1].tau - samples[begin].tau) / next_low > options.max_piece_duration)
+          break;
+        low = next_low;
+        high = next_high;
+        speed = next_speed;
+        turn = next_turn;
+        ++stop;
+      }
+      const double sigma_begin = samples[begin].sigma;
+      const double sigma_end = stop == end ? traj[i].getDuration() : samples[stop].sigma;
+      if (sigma_end > sigma_begin) {
+        durations.push_back((sigma_end - sigma_begin) / low);
+        coefficients.push_back(subPieceCoefficients(traj[i].getCoeffMat(), sigma_begin, low));
+        rates.push_back(low);
+      }
+      begin = stop;
+    }
+  }
+  if (durations.empty()) {
+    if (report != nullptr) *report = result;
+    return traj;
+  }
+
+  Trajectory<7, 3> retimed(durations, coefficients);
+  result.pieces_after = retimed.getPieceNum();
+  result.duration_after = retimed.getTotalDuration();
+  result.start_speed_after = retimed.getVel(0.0).head(2).norm();
+  result.after = measureRetimedPeaks(retimed, rates, options.min_speed);
+  if (report != nullptr) *report = result;
+  return retimed;
+}
